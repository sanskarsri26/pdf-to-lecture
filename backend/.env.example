GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
ENABLE_TTS=true
TTS_PROVIDER=edge
TTS_VOICE=en-US-GuyNeural
TTS_RATE=-6%
TTS_PITCH=-2Hz
TTS_LANG=en
ENABLE_OCR=true
OCR_LANG=eng
OCR_DPI=200
OCR_MIN_TEXT_CHARS=40
MAX_SLIDES_PER_CHUNK=3
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_UPLOAD_MB=25
MAX_PDF_PAGES=100
CHUNK_WORDS=260
CHUNK_OVERLAP=45
JOB_WORKERS=2
DATABASE_PATH=backend/data/app.db
# Optional pricing inputs make estimated cost explicit instead of hard-coding volatile rates.
GEMINI_INPUT_USD_PER_MILLION=0
GEMINI_OUTPUT_USD_PER_MILLION=0
